generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  telegramId    String   @unique
  username      String?
  firstName     String?
  lastName      String?
  phoneNumber   String?
  photoUrl      String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workoutAccess WorkoutCollectionAccess[]
  recipeAccess  RecipeCollectionAccess[]
  transactions  Transaction[]
  contentViews  ContentView[]
  favoriteRecipes FavoriteRecipe[]
  workoutProgress WorkoutProgress[]
  clientProfile ClientProfile?

  @@map("users")
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

model WorkoutCollection {
  id          String   @id @default(uuid())
  title       String
  description String?
  coverImage  String?
  coverImageFit String @default("cover")
  coverImagePosition String @default("center")
  price       Int
  discount    Int?     @default(0)
  discountType DiscountType? @default(PERCENTAGE)
  discountEndDate DateTime?
  isActive    Boolean  @default(true)
  isInDevelopment Boolean @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workouts    Workout[]
  userAccess  WorkoutCollectionAccess[]
  newsLinks   NewsWorkoutLink[]
  sections    WorkoutSection[] @relation("CollectionSections")

  @@map("workout_collections")
}

model Workout {
  id          String   @id @default(uuid())
  collectionId String
  title       String
  description String?
  coverImage  String?
  calories    Int?
  duration    Int?
  rutubeUrl   String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  collection  WorkoutCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("workouts")
}

model WorkoutSection {
  id           String   @id @default(uuid())
  collectionId String
  title        String
  description  String?
  type         SectionType @default(VIDEO) 
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection   WorkoutCollection @relation("CollectionSections", fields: [collectionId], references: [id], onDelete: Cascade)
  items        WorkoutSectionItem[]

  @@map("workout_sections")
}

model WorkoutSectionItem {
  id          String   @id @default(uuid())
  sectionId   String
  title       String
  description String?
  coverImage  String?
  
  // Для видео тренировок
  calories    Int?
  duration    Int?
  rutubeUrl   String?
  
  // Для текстового контента
  content     String?  @db.Text
  
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     WorkoutSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("workout_section_items")
}

enum SectionType {
  VIDEO        
  TEXT_FOLDER  
}

model RecipeCollection {
  id          String   @id @default(uuid())
  title       String
  description String?
  coverImage  String?
  coverImageFit String @default("cover")
  coverImagePosition String @default("center")
  price       Int
  discount    Int?     @default(0)
  discountType DiscountType? @default(PERCENTAGE)
  discountEndDate DateTime?
  isActive    Boolean  @default(true)
  isInDevelopment Boolean @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipes     Recipe[]
  userAccess  RecipeCollectionAccess[]
  newsLinks   NewsRecipeLink[]

  @@map("recipe_collections")
}

model Recipe {
  id            String   @id @default(uuid())
  collectionId  String
  title         String
  description   String?
  coverImage    String?
  coverImageFit String  @default("cover")
  coverImagePosition String @default("center")
  category      RecipeCategory
  cookingTime   Int?
  ingredients   Json
  instructions  String
  benefits      String?  @db.Text
  caloriesPer100g Int?
  proteinPer100g  Float?
  fatPer100g      Float?
  carbsPer100g    Float?
  caloriesPerServing Int?
  proteinPerServing  Float?
  fatPerServing      Float?
  carbsPerServing    Float?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collection    RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  favoritedBy   FavoriteRecipe[]

  @@map("recipes")
}

enum RecipeCategory {
  BREAKFAST
  MAIN_COURSE
  SNACK
  SALAD
  DESSERT
  SMOOTHIE
}

// Справочник ингредиентов для списка покупок: группа = «общее название»,
// псевдонимы = варианты написания из рецептов, которые в неё объединяются.
model IngredientGroup {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  aliases   IngredientAlias[]

  @@map("ingredient_groups")
}

model IngredientAlias {
  id      String @id @default(uuid())
  alias   String @unique // нормализованное (lowercase) «сырое» название из рецепта
  groupId String

  group   IngredientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("ingredient_aliases")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model WorkoutCollectionAccess {
  id           String   @id @default(uuid())
  userId       String
  collectionId String
  grantedAt    DateTime @default(now())
  grantedBy    String?

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   WorkoutCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@map("workout_collection_access")
}

model RecipeCollectionAccess {
  id           String   @id @default(uuid())
  userId       String
  collectionId String
  grantedAt    DateTime @default(now())
  grantedBy    String?

  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection   RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@map("recipe_collection_access")
}

model News {
  id          String   @id @default(uuid())
  title       String
  content     String
  excerpt     String?
  bannerImage String?
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workoutLinks NewsWorkoutLink[]
  recipeLinks  NewsRecipeLink[]

  @@map("news")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NewsWorkoutLink {
  id          String   @id @default(uuid())
  newsId      String
  collectionId String

  news        News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  collection  WorkoutCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([newsId, collectionId])
  @@map("news_workout_links")
}

model NewsRecipeLink {
  id          String   @id @default(uuid())
  newsId      String
  collectionId String

  news        News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  collection  RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([newsId, collectionId])
  @@map("news_recipe_links")
}

model Transaction {
  id                  String   @id @default(uuid())
  userId              String
  type                TransactionType
  itemType            ItemType
  itemId              String
  amount              Int
  status              TransactionStatus @default(PENDING)
  paymentMethod       String?
  paymentId           String?
  paymeTransactionId  String?  @unique
  paymeCreateTime     BigInt?
  paymePerformTime    BigInt?
  paymeCancelTime     BigInt?
  paymeReason         Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  PURCHASE
  REFUND
}

enum ItemType {
  WORKOUT_COLLECTION
  RECIPE_COLLECTION
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  email     String   @unique
  role      AdminRole @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

model ContentView {
  id          String   @id @default(uuid())
  userId      String
  itemType    ContentType
  itemId      String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([itemType, itemId])
  @@index([createdAt])
  @@map("content_views")
}

enum ContentType {
  WORKOUT_COLLECTION
  RECIPE_COLLECTION
  WORKOUT
  RECIPE
  NEWS
  BROADCAST // переход по кнопке рассылки (itemId = Broadcast.id)
  AD // переход по рекламе (itemId = метка из ?startapp=, напр. insta_reels5)
}

// Журнал рассылок: для аналитики «сколько перешло по кнопке».
// Кнопке автоматически добавляется ?bc=<id>, бот фиксирует переход как ContentView.
model Broadcast {
  id         String   @id @default(uuid())
  message    String
  buttonText String?
  buttonUrl  String?
  imageUrl   String?
  total      Int      @default(0)
  sent       Int      @default(0)
  blocked    Int      @default(0)
  deleted    Int      @default(0)
  sentAt     DateTime @default(now())

  @@map("broadcasts")
}

// ===== Клиентская зона тренера =====

// Отметка «мой клиент»: наличие записи открывает пользователю раздел «Мой прогресс».
// Ставится/снимается вручную тренером в админке.
model ClientProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  status        ClientStatus @default(ACTIVE)
  notes         String? // заметки тренера, клиенту не видны
  questionnaire Json? // ответы первичной анкеты (вопросы добавим позже)
  startedAt     DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  measurements ClientMeasurement[]
  photos       ClientPhoto[]
  feedback     ClientFeedback[]

  @@map("client_profiles")
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

// Замеры тела клиента (см и кг). Вносит клиент из бота или тренер из админки.
model ClientMeasurement {
  id        String   @id @default(uuid())
  clientId  String
  date      DateTime @default(now())
  weight    Float? // кг
  chest     Float? // грудь, см
  waist     Float? // талия, см
  belly     Float? // живот, см
  hips      Float? // бёдра, см
  thigh     Float? // бедро (нога), см
  arm       Float? // рука, см
  note      String?
  byTrainer Boolean  @default(false) // кто внёс запись
  createdAt DateTime @default(now())

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@map("client_measurements")
}

// Фото прогресса клиента (перед/бок/зад). Файлы лежат в ПРИВАТНОМ хранилище
// (private-uploads, nginx его не раздаёт) — доступ только через API с проверкой прав.
model ClientPhoto {
  id        String     @id @default(uuid())
  clientId  String
  date      DateTime   @default(now())
  angle     PhotoAngle
  filePath  String // имя файла в приватном хранилище
  byTrainer Boolean    @default(false)
  createdAt DateTime   @default(now())

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, date])
  @@map("client_photos")
}

enum PhotoAngle {
  FRONT
  SIDE // устаревший (ранние тесты); в UI больше не используется
  SIDE_LEFT
  SIDE_RIGHT
  BACK
}

// Впечатления клиента от тренировок — комментарии для тренера
model ClientFeedback {
  id        String   @id @default(uuid())
  clientId  String
  text      String
  createdAt DateTime @default(now())

  client ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("client_feedback")
}

// Ручной учёт оплат «мимо Payme» (рублёвая карта МИР).
// Владелец отмечает в админке прошедшую оплату — сумма попадает в общий доход.
model ManualPayment {
  id             String   @id @default(uuid())
  collectionId   String
  collectionType ItemType // WORKOUT_COLLECTION | RECIPE_COLLECTION
  amount         Int      // в сумах (единообразно с Transaction.amount)
  telegramId     String?  // кому (опционально, для истории)
  note           String?
  paidAt         DateTime @default(now()) // дата оплаты (используется в разбивке дохода)
  createdAt      DateTime @default(now())

  @@index([paidAt])
  @@map("manual_payments")
}

model FavoriteRecipe {
  id        String   @id @default(uuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
  @@map("favorite_recipes")
}

model WorkoutProgress {
  id          String   @id @default(uuid())
  userId      String
  // id WorkoutSectionItem или legacy Workout — без FK, чтобы покрыть оба типа
  itemId      String
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("workout_progress")
}

[Unit]
Description=IPv6 relay to api.telegram.org for docker containers (host IPv4 route to Telegram is dead)
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/socat TCP4-LISTEN:8443,bind=172.17.0.1,fork,reuseaddr TCP6:api.telegram.org:443
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
